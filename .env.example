# Másold .env néven a repó gyökerébe, és írd át a saját adatbázisodra.
# A jelszó különleges karaktereit kódolni kell: @ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F, % -> %25
DATABASE_URL=postgres://notetaker_app:JELSZO@localhost:5432/notetaker
PORT=3000

# A tesztek ezt az adatbázist minden futáskor TÖRLIK és újraépítik.
# A nevében szerepelnie kell a "test" szónak.
TEST_DATABASE_URL=postgres://notetaker_app:JELSZO@localhost:5432/notetaker_test
